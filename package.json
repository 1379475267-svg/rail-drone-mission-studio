{
  "name": "rail-drone-mission-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "build:pages": "vue-tsc --noEmit && vite build --base=/rail-drone-mission-studio/",
